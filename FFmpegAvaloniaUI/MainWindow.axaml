<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
        Width="450"
        Height="450"
        x:Class="FFmpegAvaloniaUI.MainWindow"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="FFmpeg converter by NEROMOUS3">

    <Panel Height="450" Width="450" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Button x:Name="SelectFileButton" HorizontalAlignment="Stretch" 
                VerticalAlignment="Top" 
                Background="Yellow" 
                Foreground="Black"
                Click="SelectFileButton_OnClick">
            <TextBlock HorizontalAlignment="Center" FontSize="24">Select file test</TextBlock>
        </Button>
        <Button x:Name="FFmpegInstall" HorizontalAlignment="Stretch" 
                VerticalAlignment="Bottom" 
                Background="Green" 
                Foreground="Black"
                Click = "InstallFFMpeg_OnClick">
            <TextBlock HorizontalAlignment="Center" FontSize="24">Install FFmpeg</TextBlock>
        </Button>
    </Panel>
</Window>